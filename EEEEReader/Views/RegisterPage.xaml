<Page
    x:Class="EEEEReader.Views.RegisterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EEEEReader.Views">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="360" Spacing="12">
            <TextBlock Text="Inscription" FontSize="44" FontWeight="SemiBold" TextAlignment="Center" Margin="0,12"/>
            <TextBox x:Name="UserNameBox" Header="Nom d'utilisateur"/>
            <PasswordBox x:Name="PasswordBox" Header="Mot de passe"/>
            <PasswordBox x:Name="PasswordConfirmationBox" Header="Confirmer le mot de passe"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="220">
                <Button Content="Valider" Click="OnRegisterClick" />
                <Button Content="Annuler" Click="AnnulerClick"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>